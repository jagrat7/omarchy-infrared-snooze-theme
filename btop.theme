# Infrared Snooze for btop.
#
# Omarchy's generated version paints the net box and the download and
# available-memory graphs red, which reads as an alarm in a red theme.
# Here only load glows: CPU, used memory, upload and processes run from dim
# to the infrared accent, while free or incoming things stay cool.

theme[main_bg]="#130b0d"

theme[main_fg]="#ead2ca"

theme[title]="#ead2ca"

theme[hi_fg]="#ff5c3a"

theme[selected_bg]="#3b1c22"

theme[selected_fg]="#ff5c3a"

theme[inactive_fg]="#7d5d60"

theme[graph_text]="#d6bab3"

theme[meter_bg]="#3b1c22"

theme[proc_misc]="#d6bab3"

theme[cpu_box]="#ff5c3a"
theme[mem_box]="#d27aa8"
theme[net_box]="#8d9fd8"
theme[proc_box]="#7d5d60"

theme[div_line]="#7d5d60"

theme[temp_start]="#a3b87c"
theme[temp_mid]="#f2a65a"
theme[temp_end]="#e8476a"

theme[cpu_start]="#8c6f6d"
theme[cpu_mid]="#ff8650"
theme[cpu_end]="#ff5c3a"

theme[free_start]="#d27aa8"
theme[free_mid]="#8d9fd8"
theme[free_end]="#7fb5ab"

theme[cached_start]="#8d9fd8"
theme[cached_mid]="#7fb5ab"
theme[cached_end]="#d27aa8"

theme[available_start]="#8d9fd8"
theme[available_mid]="#7fb5ab"
theme[available_end]="#a3b87c"

theme[used_start]="#f2a65a"
theme[used_mid]="#ff8650"
theme[used_end]="#ff5c3a"

theme[download_start]="#8d9fd8"
theme[download_mid]="#aebdf2"
theme[download_end]="#a2d2c8"

theme[upload_start]="#f2a65a"
theme[upload_mid]="#ff8650"
theme[upload_end]="#ff5c3a"

theme[process_start]="#8c6f6d"
theme[process_mid]="#ff8650"
theme[process_end]="#ff5c3a"

theme[gradient_color_0]="#130b0d"
theme[gradient_color_1]="#1f1215"
theme[gradient_color_2]="#3b1c22"
theme[gradient_color_3]="#7d5d60"
theme[gradient_color_4]="#8c6f6d"
theme[gradient_color_5]="#ead2ca"
theme[gradient_color_6]="#d6bab3"
theme[gradient_color_7]="#fcece6"
