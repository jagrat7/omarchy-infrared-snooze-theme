# Infrared Snooze for btop.
#
# Omarchy's generated version paints the net box and the download and
# available-memory graphs red, which reads as an alarm in a red theme.
# Here only load glows: CPU, used memory, upload and processes run from dim
# to the ember red accent, while free or incoming things stay cool.

theme[main_bg]="#150b0b"

theme[main_fg]="#c2a08e"

theme[title]="#c2a08e"

theme[hi_fg]="#cc432e"

theme[selected_bg]="#3d1f1c"

theme[selected_fg]="#cc432e"

theme[inactive_fg]="#785c56"

theme[graph_text]="#b69684"

theme[meter_bg]="#3d1f1c"

theme[proc_misc]="#b69684"

theme[cpu_box]="#cc432e"
theme[mem_box]="#a46f8a"
theme[net_box]="#737ea0"
theme[proc_box]="#785c56"

theme[div_line]="#785c56"

theme[temp_start]="#869a5a"
theme[temp_mid]="#c99a4a"
theme[temp_end]="#c2445f"

theme[cpu_start]="#896d65"
theme[cpu_mid]="#d27a3a"
theme[cpu_end]="#cc432e"

theme[free_start]="#a46f8a"
theme[free_mid]="#737ea0"
theme[free_end]="#6f8f84"

theme[cached_start]="#737ea0"
theme[cached_mid]="#6f8f84"
theme[cached_end]="#a46f8a"

theme[available_start]="#737ea0"
theme[available_mid]="#6f8f84"
theme[available_end]="#869a5a"

theme[used_start]="#c99a4a"
theme[used_mid]="#d27a3a"
theme[used_end]="#cc432e"

theme[download_start]="#737ea0"
theme[download_mid]="#8892b3"
theme[download_end]="#84a597"

theme[upload_start]="#c99a4a"
theme[upload_mid]="#d27a3a"
theme[upload_end]="#cc432e"

theme[process_start]="#896d65"
theme[process_mid]="#d27a3a"
theme[process_end]="#cc432e"

theme[gradient_color_0]="#150b0b"
theme[gradient_color_1]="#211312"
theme[gradient_color_2]="#3d1f1c"
theme[gradient_color_3]="#785c56"
theme[gradient_color_4]="#896d65"
theme[gradient_color_5]="#c2a08e"
theme[gradient_color_6]="#b69684"
theme[gradient_color_7]="#d8b8a2"
